+void Foam::neoHookeanElastic::checkJacobian
+(
+    const surfaceScalarField& J
+) const
+{
+    scalar localMin = GREAT;
+    label localIndex = -1;
+    label localPatch = -1;
+    vector localLocation(vector::zero);
+
+    forAll(J.primitiveField(), faceI)
+    {
+        if (J[faceI] < localMin)
+        {
+            localMin = J[faceI];
+            localIndex = faceI;
+            localPatch = -1;
+            localLocation = mesh().Cf()[faceI];
+        }
+    }
+
+    forAll(J.boundaryField(), patchI)
+    {
+        forAll(J.boundaryField()[patchI], faceI)
+        {
+            if (J.boundaryField()[patchI][faceI] < localMin)
+            {
+                localMin = J.boundaryField()[patchI][faceI];
+                localIndex = faceI;
+                localPatch = patchI;
+                localLocation = mesh().Cf().boundaryField()[patchI][faceI];
+            }
+        }
+    }
+
+    const scalar minJ = returnReduce(localMin, minOp<scalar>());
+
+    if (minJ <= 0)
+    {
+        label minProc =
+            (localMin == minJ ? Pstream::myProcNo() : labelMax);
+        minProc = returnReduce(minProc, minOp<label>());
+
+        label minIndex = Pstream::myProcNo() == minProc ? localIndex : 0;
+        label minPatch = Pstream::myProcNo() == minProc ? localPatch : 0;
+        vector minLocation =
+            Pstream::myProcNo() == minProc ? localLocation : vector::zero;
+        reduce(minIndex, sumOp<label>());
+        reduce(minPatch, sumOp<label>());
+        reduce(minLocation, sumOp<vector>());
+
+        FatalErrorInFunction
+            << "Invalid deformation in neoHookeanElastic:" << nl
+            << "det(F) must remain strictly positive before evaluating "
+            << "J^(-2/3)." << nl
+            << "Minimum J = " << minJ << nl
+            << "Time = " << mesh().time().timeName() << nl
+            << "Mechanical law = neoHookeanElastic" << nl
+            << "Processor = " << minProc << nl
+            << (minPatch < 0 ? "Local internal face = " : "Local boundary face = ")
+            << minIndex << nl
+            << "Location = " << minLocation
+            << abort(FatalError);
+    }
+}
