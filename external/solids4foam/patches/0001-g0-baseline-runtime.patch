+void nonLinGeomUpdatedLagSolid::writeOperatorDiagnostics
+(
+    const word& stage,
+    const scalar ddScale
+) const
+{
+    const surfaceVectorField n(mesh().Sf()/mesh().magSf());
+    const surfaceVectorField SfCurrent
+    (
+        fvc::interpolate(relJ_*relFinv_.T()) & mesh().Sf()
+    );
+    const surfaceScalarField magSfCurrent(mag(SfCurrent));
+    const surfaceVectorField nCurrent(SfCurrent/magSfCurrent);
+    surfaceVectorField tractionBase(nCurrent & fvc::interpolate(sigma()));
+    surfaceVectorField traction(tractionBase);
+    const scalar scaleFactor =
+        readScalar(stabilisation().dict().lookup("scaleFactor"));
+    const volVectorField scaledDD
+    (
+        IOobject
+        (
+            "scaledDDOperatorDiagnostic",
+            runTime().timeName(),
+            mesh(),
+            IOobject::NO_READ,
+            IOobject::NO_WRITE,
+            false
+        ),
+        ddScale*DD()
+    );
+    const surfaceTensorField gradDDf
+    (
+        ddScale*fvc::interpolate(gradDD())
+    );
+    traction +=
+        scaleFactor*impKf_*(fvc::snGrad(scaledDD) - (n & gradDDf));
+    surfaceVectorField force(magSfCurrent*traction);
+    enforceTractionBoundaries(force, DD(), nCurrent, magSfCurrent);
+    surfaceVectorField forceBase(magSfCurrent*tractionBase);
+    enforceTractionBoundaries(forceBase, DD(), nCurrent, magSfCurrent);
+
+    const tmp<volVectorField> tInternalBoundary(fvc::div(force));
+    const tmp<volVectorField> tGravity(rho_*g());
+    const tmp<volVectorField> tInertia(-rho_*fvc::d2dt2(D()));
+    vectorField internalBoundary(tInternalBoundary().primitiveField());
+    vectorField gravity(tGravity().primitiveField());
+    vectorField inertia(tInertia().primitiveField());
+    const tmp<volVectorField> tBase(fvc::div(forceBase));
+    vectorField baseResidual(tBase().primitiveField());
+    internalBoundary *= mesh().V();
+    gravity *= mesh().V();
+    inertia *= mesh().V();
+    baseResidual *= mesh().V();
+    baseResidual += gravity + inertia;
+    const vectorField stabilisationResidual
+    (
+        internalBoundary - baseResidual + gravity + inertia
+    );
+    const vectorField residual(internalBoundary + gravity + inertia);
+
+    vector boundaryForce(vector::zero);
+    vector boundaryMoment(vector::zero);
+    forAll(force.boundaryField(), patchI)
+    {
+        if (!mesh().boundary()[patchI].coupled())
+        {
+            const vectorField& fp = force.boundaryField()[patchI];
+            boundaryForce += sum(fp);
+            boundaryMoment += sum(mesh().Cf().boundaryField()[patchI] ^ fp);
+        }
+    }
+    reduce(boundaryForce, sumOp<vector>());
+    reduce(boundaryMoment, sumOp<vector>());
+
+    const scalar rL2 = sqrt(gSum(magSqr(residual)));
+    const scalar rLinf = gMax(mag(residual));
+    const scalar intL2 = sqrt(gSum(magSqr(internalBoundary)));
+    const scalar intLinf = gMax(mag(internalBoundary));
+    const scalar inertiaL2 = sqrt(gSum(magSqr(inertia)));
+    const scalar inertiaLinf = gMax(mag(inertia));
+    const scalar gravityL2 = sqrt(gSum(magSqr(gravity)));
+    const scalar baseL2 = sqrt(gSum(magSqr(baseResidual)));
+    const scalar baseLinf = gMax(mag(baseResidual));
+    const scalar stabL2 = sqrt(gSum(magSqr(stabilisationResidual)));
+    const scalar stabLinf = gMax(mag(stabilisationResidual));
+    const scalar baseStabDot = gSum(baseResidual & stabilisationResidual);
+    const scalar cosTheta =
+        baseStabDot/(max(baseL2*stabL2, VSMALL));
+    const scalar aStab = stabL2/max(baseL2, VSMALL);
+    const scalar cStab = rL2/max(baseL2, VSMALL);
+    const scalar dMax = gMax(mag(D().primitiveField()));
+    const scalar ddMax = gMax(mag(DD().primitiveField()));
+    const scalar fL2 = sqrt(gSum(magSqr(F_.primitiveField())));
+    const scalar sigmaL2 = sqrt(gSum(magSqr(sigma().primitiveField())));
+    const scalar jMin = gMin(J_.primitiveField());
+    const scalar jMax = gMax(J_.primitiveField());
+    const scalar uMax = gMax(mag(U().primitiveField()));
+    const scalar aMax = gMax(mag(A_.primitiveField()));
+
+    Info<< "STRUCTURAL_OPERATOR_DIAGNOSTIC"
+        << " stage=" << stage
+        << " time=" << runTime().timeName()
+        << " DDscale=" << ddScale
+        << " RmomL2_N=" << rL2
+        << " RmomLinf_N=" << rLinf
+        << " RinternalBoundaryL2_N=" << intL2
+        << " RinternalBoundaryLinf_N=" << intLinf
+        << " RinertiaL2_N=" << inertiaL2
+        << " RinertiaLinf_N=" << inertiaLinf
+        << " RgravityL2_N=" << gravityL2
+        << " RbaseL2_N=" << baseL2
+        << " RbaseLinf_N=" << baseLinf
+        << " RstabilisationL2_N=" << stabL2
+        << " RstabilisationLinf_N=" << stabLinf
+        << " Astab=" << aStab
+        << " Cstab=" << cStab
+        << " cosTheta=" << cosTheta
+        << " boundaryForce_N=" << boundaryForce
+        << " boundaryMoment_Nm=" << boundaryMoment
+        << " Dmax_m=" << dMax
+        << " DDmax_m=" << ddMax
+        << " F_L2=" << fL2
+        << " sigmaL2_Pa=" << sigmaL2
+        << " Jmin=" << jMin
+        << " Jmax=" << jMax
+        << " Umax_mps=" << uMax
+        << " Amax_mps2=" << aMax
+        << endl;
+}
