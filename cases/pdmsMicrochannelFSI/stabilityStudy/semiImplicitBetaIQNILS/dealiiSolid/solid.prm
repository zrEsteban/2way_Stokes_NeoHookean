set mesh = dealiiSolid/solid.msh
set input = dealiiSolid/robin-in.csv
set query input = dealiiSolid/robin-query.csv
set output = dealiiSolid/robin-out.csv
set vtk output = dealiiSolid/solid-trial.vtu
set state input = dealiiSolid/accepted-state.bin
set state output = dealiiSolid/trial-state.bin
set rho = 970.0
set mu = 778200
set bulk modulus = 3631600.0
set delta t = 1e-07
set time integration = bdf2
set solid impedance = 0
set interface boundary = 4
set clamped boundary 1 = 1
set clamped boundary 2 = 2
set clamped boundary 3 = 3
set minimum jacobian = 1e-8
set maximum newton iterations = 30
set newton tolerance = 1e-18
set newton relative tolerance = 1e-3
set newton damping = 1
set linear solver = iterative
set linear maximum iterations = 5000
set linear relative tolerance = 1e-10
set ssor relaxation = 1.2
