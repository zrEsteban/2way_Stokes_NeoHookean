S4F_ROOT ?= $(SOLIDS4FOAM_ROOT)

ifeq ($(strip $(S4F_ROOT)),)
    $(error S4F_ROOT must point to the fixed solids4foam checkout)
endif

sinclude $(S4F_ROOT)/etc/wmake-options

EXE_INC = \
    -Wno-old-style-cast -Wno-deprecated-declarations \
    $(VERSION_SPECIFIC_INC) \
    -I$(S4F_ROOT)/src/solids4FoamModels/lnInclude \
    -I$(S4F_ROOT)/src/blockCoupledSolids4FoamTools/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/overset/lnInclude

LIB_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
    -lsolids4FoamModels \
    -lfiniteVolume \
    -lmeshTools \
    -ldynamicMesh
