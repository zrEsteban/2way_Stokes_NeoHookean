S4F_ROOT ?= $(SOLIDS4FOAM_ROOT)

ifeq ($(strip $(S4F_ROOT)),)
    $(error S4F_ROOT must point to the fixed solids4foam checkout)
endif

EXE_INC = \
    -Wno-old-style-cast -Wno-deprecated-declarations \
    -I$(S4F_ROOT)/src/solids4FoamModels/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude

LIB_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
    -lsolids4FoamModels \
    -lfiniteVolume \
    -lmeshTools
